{
  "name": "joyce-bot",
  "version": "0.1.0",
  "description": "Bot que conecta GitHub e Discord para automatizar notificações de PRs, builds e issues.",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@11.10.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:webhook": "node scripts/test-webhook.js",
    "commands:register": "tsx scripts/register-commands.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
