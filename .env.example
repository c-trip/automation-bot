PORT=3333

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

DISCORD_CHANNEL_ID=

DISCORD_CHANNEL_PRS=
DISCORD_CHANNEL_BUILDS=
DISCORD_CHANNEL_ISSUES=
DISCORD_CHANNEL_DEPLOYS=

GITHUB_WEBHOOK_SECRET=

# postgresql://usuario:senha@host:porta/banco
DATABASE_URL=

# Engineering Project Assistant — check-in automático, follow-up e relatório semanal.
# Exige DATABASE_URL configurada. Sem os IDs abaixo, cada job fica desativado sozinho.

# Canal onde o check-in é postado (ex.: #atualizacoes-diarias)
DISCORD_CHECKIN_CHANNEL_ID=
# Cargo do Discord que define quem é "equipa" (pros lembretes de 24h e o relatório)
DISCORD_TEAM_ROLE_ID=
# Quem recebe o relatório semanal por DM
DISCORD_CEO_USER_ID=

# De quanto em quanto tempo um novo check-in é postado (padrão: 48h)
CHECKIN_INTERVAL_HOURS=48
# Depois de quanto tempo sem resposta o lembrete é enviado (padrão: 24h)
CHECKIN_REMINDER_AFTER_HOURS=24
# De quanto em quanto tempo o relatório semanal é enviado (padrão: 7 dias)
WEEKLY_REPORT_INTERVAL_DAYS=7
# De quanto em quanto tempo o scheduler verifica se algum job está pendente (padrão: 15min)
SCHEDULER_POLL_MINUTES=15
